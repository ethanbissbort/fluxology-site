# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production build
dist/
build/

# Astro generated types/cache (regenerated by `astro sync` / build)
.astro/

# Environment variables
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store

# Logs
logs/
*.log

# Credential material. docker-compose.yml documents a Docker-secrets
# migration that has the operator create ./secrets/office_ingest_token etc.
# on the VPS — without these entries, following that documented procedure in
# a working copy plus one `git add -A` would commit three live production
# write tokens to public git history.
secrets/
*.pem
*.key

# Runtime data written by the services when run locally.
# services/contact-api/README.md documents
#   INQUIRY_LOG_PATH=./data/inquiries.jsonl PORT=8081 npm start
# as the local-dev invocation, which writes services/contact-api/data/ —
# inside the repository. Every record in that file holds a real name, email,
# phone number, message, client IP and User-Agent, and the store deliberately
# chmods it 0600. One `git add -A` after a local test would put that in public
# git history permanently. These two rules mirror
# services/contact-api/.dockerignore, which already excluded both.
services/*/data/
*.jsonl

# Temporary files
*.tmp
*.temp
.cache/

# OS files
Thumbs.db
.DS_Store

# Future assets (uncomment when needed)
# src/assets/images/*.jpg
# src/assets/images/*.png
