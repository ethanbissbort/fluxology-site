---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import SoftwareShowcase from '../components/SoftwareShowcase.astro';
import About from '../components/About.astro';
import OperatingModel from '../components/OperatingModel.astro';
import DBASection from '../components/DBASection.astro';
import Roadmap from '../components/Roadmap.astro';
import Footer from '../components/Footer.astro';

import ScrollProgress from '../components/ScrollProgress.svelte';
import ThemeTransition from '../components/ThemeTransition.svelte';
import ParticleSystem from '../components/ParticleSystem.svelte';
import ContactForm from '../components/ContactForm.svelte';
import NavigationMenu from '../components/NavigationMenu.svelte';
import BackToTop from '../components/BackToTop.svelte';

import { dbaOverviews } from '../data/dbaPlans';
---

<BaseLayout
  title="Fluxology, Inc. | Independent Software Publisher & Staged Micro-Enterprise"
  description="Fluxology, Inc. is a federally incorporated Canadian company developing and publishing independent software products, including iOS applications, alongside staged future plans for fabrication, digital production support and homestead food systems."
>
  <ScrollProgress client:load />
  <ThemeTransition client:load />
  <BackToTop client:load />

  <Navigation />
  <NavigationMenu client:load />

  <main id="main-content" tabindex="-1">
    <Hero />
    <SoftwareShowcase />
    <About />
    <OperatingModel />

    {
      dbaOverviews.map((dba) => (
        <DBASection {...dba}>
          <ParticleSystem
            slot="particles"
            theme={dba.theme}
            variant={dba.particleVariant}
            client:visible
          />
        </DBASection>
      ))
    }

    <Roadmap />

    <section id="contact" data-theme="corporate" class="section contact-section">
      <div class="background-layer">
        <div class="corporate-flux"></div>
      </div>

      <div class="content-layer">
        <div class="container">
          <header class="section-header observe-fade">
            <p class="contact-eyebrow">Software active · trade lines pre-launch</p>
            <h2 class="section-title">Company, Product & Future Project Inquiries</h2>
            <p class="section-subtitle">
              Send software feedback or support questions, company inquiries, supplier or collaboration proposals,
              or questions about the staged future operating plan. Trade-service booking is not yet open.
            </p>
          </header>

          <ContactForm client:visible />
        </div>
      </div>

      <div class="accent-layer" id="contactParticles">
        <ParticleSystem theme="corporate" client:visible />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .contact-eyebrow {
    margin-bottom: var(--spacing-sm);
    color: var(--corporate-accent-silver);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
  }
</style>
