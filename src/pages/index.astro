---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import OperatingModel from '../components/OperatingModel.astro';
import DBASection from '../components/DBASection.astro';
import Roadmap from '../components/Roadmap.astro';
import Footer from '../components/Footer.astro';

import ScrollProgress from '../components/ScrollProgress.svelte';
import ThemeTransition from '../components/ThemeTransition.svelte';
import ParticleSystem from '../components/ParticleSystem.svelte';
import ContactForm from '../components/ContactForm.svelte';
import NavigationMenu from '../components/NavigationMenu.svelte';
import BackToTop from '../components/BackToTop.svelte';

import { dbaOverviews } from '../data/dbaPlans';
---

<BaseLayout
  title="Fluxology, Inc. | Trade-Led Homestead Micro-Enterprise"
  description="Fluxology, Inc. is a one-owner Canadian corporation planning four staged operating lines: mobile fabrication and welding, a supporting 3D Lab, a subsistence-first greenhouse, and a perennial orchard and food forest."
>
  <ScrollProgress client:load />
  <ThemeTransition client:load />
  <BackToTop client:load />

  <Navigation />
  <NavigationMenu client:load />

  <main id="main-content" tabindex="-1">
    <Hero />
    <About />
    <OperatingModel />

    {
      dbaOverviews.map((dba) => (
        <DBASection {...dba}>
          <ParticleSystem
            slot="particles"
            theme={dba.theme}
            variant={dba.particleVariant}
            client:visible
          />
        </DBASection>
      ))
    }

    <Roadmap />

    <section id="contact" data-theme="corporate" class="section contact-section">
      <div class="background-layer">
        <div class="corporate-flux"></div>
      </div>

      <div class="content-layer">
        <div class="container">
          <header class="section-header observe-fade">
            <p class="contact-eyebrow">Foundation period · pre-launch</p>
            <h2 class="section-title">Planning & Future Project Inquiries</h2>
            <p class="section-subtitle">
              Share a future customer need, supplier relationship, local collaboration idea or question about the
              staged operating plan. Active service booking is not yet open.
            </p>
          </header>

          <ContactForm client:visible />

          <form
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            hidden
          >
            <input type="hidden" name="form-name" value="contact" />
            <input type="text" name="companyName" />
            <input type="text" name="fullName" />
            <input type="email" name="email" />
            <input type="tel" name="phone" />
            <select name="serviceInterest">
              <option value="fabrication">Future Fabrication &amp; Welding Need</option>
              <option value="3d-lab">Future 3D Lab Need</option>
              <option value="greenhouse">Greenhouse / Growing-System Interest</option>
              <option value="orchard">Orchard &amp; Food Forest Interest</option>
              <option value="multiple">Cross-Division Collaboration</option>
              <option value="general">Company / General Inquiry</option>
            </select>
            <textarea name="message"></textarea>
            <input name="bot-field" />
          </form>
        </div>
      </div>

      <div class="accent-layer" id="contactParticles">
        <ParticleSystem theme="corporate" client:visible />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .contact-eyebrow {
    margin-bottom: var(--spacing-sm);
    color: var(--corporate-accent-silver);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
  }
</style>
