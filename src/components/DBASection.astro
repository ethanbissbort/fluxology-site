---
interface ImageAsset {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
}

interface Service {
  icon: string;
  title: string;
  description: string;
  meta?: string;
  image?: ImageAsset;
}

interface Fact {
  label: string;
  value: string;
}

interface ProcessStep {
  title: string;
  description: string;
}

interface Boundary {
  title: string;
  description: string;
}

interface Props {
  id: string;
  theme: string;
  name: string;
  eyebrow?: string;
  status: string;
  classification: string;
  description: string;
  facts: Fact[];
  servicesTitle?: string;
  servicesIntro?: string;
  services: Service[];
  processTitle: string;
  processIntro?: string;
  processSteps: ProcessStep[];
  boundary: Boundary;
  showcaseImages?: ImageAsset[];
  sectionBackground?: string;
  detailHref: string;
  ctaText?: string;
  ctaNote?: string;
  /** Consumed by the ParticleSystem slotted into this section. */
  particleVariant?: string;
}

const {
  id,
  theme,
  name,
  eyebrow = 'Proposed operating name',
  status,
  classification,
  description,
  facts,
  servicesTitle = 'Planned scope',
  servicesIntro,
  services,
  processTitle,
  processIntro,
  processSteps,
  boundary,
  showcaseImages = [],
  sectionBackground,
  detailHref,
  ctaText = 'Start a Future-Fit Conversation',
  ctaNote = 'Planning-stage inquiries only'
} = Astro.props;

const ctaClass = {
  industrial: 'industrial-cta',
  tech: 'tech-cta',
  natural: 'natural-cta'
}[theme] ?? 'cta-primary';

const textureLayers = {
  'fabrication': ['industrial-texture'],
  '3d-lab': ['tech-gradient', 'parallax-wireframe'],
  'greenhouse': ['natural-texture', 'parallax-foliage'],
  'orchard': ['orchard-landscape', 'parallax-trees']
}[id] ?? [];
---

<section
  id={id}
  data-theme={theme}
  class="section dba-section"
  style={sectionBackground ? `--section-image: url('${sectionBackground}')` : undefined}
>
  <div class="background-layer">
    <div class="parallax-bg"></div>
    <div class="parallax-pattern"></div>
    {textureLayers.map((cls) => <div class={cls}></div>)}
    {sectionBackground && <div class="section-image-texture" aria-hidden="true"></div>}
  </div>

  <div class="content-layer">
    <div class="container">
      <header class="dba-header observe-fade">
        <p class="dba-eyebrow">{eyebrow}</p>
        <h2 class="dba-name">{name}</h2>
        <p class="dba-status">{status}</p>
      </header>

      <div class="dba-description observe-fade">
        <p>{description}</p>
      </div>

      <div class="dba-facts observe-slide-up">
        {facts.map((fact) => (
          <article>
            <span>{fact.label}</span>
            <strong>{fact.value}</strong>
          </article>
        ))}
      </div>

      <p class="dba-classification observe-fade">
        <span>Planning classification</span>
        {classification}
      </p>

      <section class="scope-block" aria-labelledby={`${id}-scope-title`}>
        <header class="subsection-header observe-fade">
          <p class="subsection-kicker">What this line is designed to do</p>
          <h3 id={`${id}-scope-title`}>{servicesTitle}</h3>
          {servicesIntro && <p>{servicesIntro}</p>}
        </header>

        <div class="services-grid observe-slide-up">
          {services.map((service) => (
            <article class:list={['service-card', { 'service-card--with-image': Boolean(service.image) }] }>
              <div class:list={['service-media', { 'service-media--placeholder': !service.image }] }>
                {service.image ? (
                  <img
                    src={service.image.src}
                    alt={service.image.alt}
                    width={service.image.width}
                    height={service.image.height}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="service-media-icon" aria-hidden="true">{service.icon}</span>
                )}
              </div>
              <div class="service-card-content">
                {service.meta && <p class="service-meta">{service.meta}</p>}
                <h4 class="service-title">{service.title}</h4>
                <p class="service-description">{service.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="process-panel observe-slide-up" aria-labelledby={`${id}-process-title`}>
        <header class="process-heading">
          <p class="subsection-kicker">Operating method</p>
          <h3 id={`${id}-process-title`}>{processTitle}</h3>
          {processIntro && <p>{processIntro}</p>}
        </header>
        <ol class:list={['process-steps', `process-count-${processSteps.length}`]}>
          {processSteps.map((step, index) => (
            <li>
              <span class="process-number">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h4>{step.title}</h4>
                <p>{step.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <aside class="boundary-note observe-fade">
        <span class="boundary-label">Operating boundary</span>
        <div>
          <h3>{boundary.title}</h3>
          <p>{boundary.description}</p>
        </div>
      </aside>

      {showcaseImages.length > 0 && (
        <div class="dba-showcase observe-scale">
          <div class={`showcase-grid showcase-count-${showcaseImages.length}`}>
            {showcaseImages.map((image, index) => (
              <figure class:list={['showcase-item', { 'showcase-item--primary': index === 0 }]}>
                <img
                  src={image.src}
                  alt={image.alt}
                  width={image.width}
                  height={image.height}
                  loading="lazy"
                  decoding="async"
                />
                {image.caption && <figcaption>{image.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      )}

      <div class="dba-action observe-fade">
        <a class={`cta-button ${ctaClass}`} href={detailHref}>{ctaText}</a>
        <a class="dba-contact-link" href="#contact">Discuss future fit</a>
        <span>{ctaNote}</span>
      </div>
    </div>
  </div>

  <div class="accent-layer" id={`${id}Particles`}>
    <slot name="particles" />
  </div>
</section>

<style>
  .dba-section {
    min-height: auto;
    content-visibility: auto;
    contain: layout style paint;
    contain-intrinsic-size: auto 2600px;
  }

  .background-layer > div {
    position: absolute;
    inset: 0;
  }

  .section-image-texture {
    background-image:
      linear-gradient(135deg, rgba(10, 14, 39, 0.68), rgba(10, 14, 39, 0.82)),
      var(--section-image);
    background-position: center;
    background-size: cover;
    mix-blend-mode: screen;
    opacity: 0.38;
  }

  .dba-eyebrow,
  .subsection-kicker,
  .boundary-label,
  .service-meta,
  .dba-classification span {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
  }

  .dba-eyebrow,
  .subsection-kicker,
  .boundary-label,
  .service-meta {
    color: var(--current-accent-primary);
  }

  .dba-status {
    display: inline-flex;
    align-items: center;
    margin: var(--spacing-md) auto 0;
    padding: var(--spacing-sm) var(--spacing-lg);
    border: 1px solid color-mix(in srgb, var(--current-accent-primary) 42%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--current-accent-primary) 10%, transparent);
    color: var(--current-text-primary);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
  }

  .dba-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-md);
    max-width: 1120px;
    margin: 0 auto var(--spacing-xl);
  }

  .dba-facts article {
    min-height: 132px;
    padding: var(--spacing-lg);
    border: 1px solid color-mix(in srgb, var(--current-accent-primary) 28%, transparent);
    border-radius: var(--radius-lg);
    background: rgba(0, 0, 0, 0.18);
    box-shadow: var(--shadow-md);
  }

  .dba-facts span {
    display: block;
    margin-bottom: var(--spacing-sm);
    color: var(--current-accent-primary);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .dba-facts strong {
    color: var(--current-text-primary);
    font-size: var(--font-size-md);
    line-height: var(--line-height-normal);
  }

  .dba-classification {
    max-width: 980px;
    margin: 0 auto var(--spacing-4xl);
    color: color-mix(in srgb, var(--current-text-secondary) 92%, transparent);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-loose);
    text-align: center;
  }

  .dba-classification span {
    display: block;
    margin-bottom: var(--spacing-xs);
    color: var(--current-accent-primary);
  }

  .subsection-header {
    max-width: 900px;
    margin: 0 auto var(--spacing-2xl);
    text-align: center;
  }

  .subsection-header h3,
  .process-heading h3 {
    color: var(--current-text-primary);
    font-size: var(--font-size-2xl);
  }

  .subsection-header > p:not(.subsection-kicker),
  .process-heading > p:not(.subsection-kicker) {
    color: var(--current-text-secondary);
    line-height: var(--line-height-loose);
  }

  .scope-block {
    margin-bottom: var(--spacing-4xl);
  }

  .service-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }

  .service-card-content {
    flex: 1;
    padding: var(--spacing-xl);
  }

  .service-media {
    position: relative;
    z-index: 1;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.24);
  }

  .service-media--placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at center, color-mix(in srgb, var(--current-accent-primary) 28%, transparent), transparent 58%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(0, 0, 0, 0.25));
  }

  .service-media-icon {
    font-size: clamp(3.5rem, 8vw, 6rem);
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.35));
  }

  .service-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow) var(--ease-out-cubic);
  }

  .service-card:hover .service-media img {
    transform: scale(1.045);
  }

  .service-meta {
    margin-bottom: var(--spacing-sm);
  }

  .process-panel {
    display: grid;
    grid-template-columns: minmax(260px, 0.7fr) minmax(0, 1.3fr);
    gap: var(--spacing-3xl);
    margin-bottom: var(--spacing-2xl);
    padding: clamp(var(--spacing-xl), 4vw, var(--spacing-3xl));
    border: 1px solid color-mix(in srgb, var(--current-accent-primary) 28%, transparent);
    border-radius: var(--radius-xl);
    background: rgba(0, 0, 0, 0.22);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
  }

  .process-steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-steps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.055);
  }

  .process-number {
    color: var(--current-accent-primary);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
  }

  .process-steps h4 {
    margin-bottom: var(--spacing-xs);
    color: var(--current-text-primary);
    font-size: var(--font-size-md);
  }

  .process-steps p {
    margin: 0;
    color: var(--current-text-secondary);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-loose);
  }

  .boundary-note {
    display: grid;
    grid-template-columns: minmax(150px, 0.25fr) minmax(0, 1fr);
    gap: var(--spacing-xl);
    align-items: start;
    margin-bottom: var(--spacing-3xl);
    padding: var(--spacing-xl);
    border-left: 5px solid var(--current-accent-primary);
    border-radius: var(--radius-md);
    background: rgba(0, 0, 0, 0.2);
  }

  .boundary-note h3 {
    margin-bottom: var(--spacing-sm);
    color: var(--current-text-primary);
    font-size: var(--font-size-lg);
  }

  .boundary-note p {
    margin: 0;
    color: var(--current-text-secondary);
    line-height: var(--line-height-loose);
  }

  .showcase-grid {
    display: grid;
    gap: var(--spacing-md);
    min-height: 430px;
  }

  .showcase-count-1 {
    grid-template-columns: 1fr;
  }

  .showcase-count-2 {
    grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.85fr);
  }

  .showcase-count-4 {
    grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.8fr);
    grid-template-rows: repeat(3, minmax(130px, 1fr));
  }

  .showcase-count-4 .showcase-item--primary {
    grid-row: 1 / 4;
  }

  .showcase-item {
    position: relative;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-lg);
    background: rgba(0, 0, 0, 0.18);
    box-shadow: var(--shadow-lg);
  }

  .showcase-item img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow) var(--ease-out-cubic);
  }

  .showcase-item:hover img {
    transform: scale(1.025);
  }

  .showcase-item figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: var(--spacing-xl) var(--spacing-md) var(--spacing-md);
    color: white;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.82));
  }

  .dba-action {
    display: flex;
    gap: var(--spacing-md) var(--spacing-xl);
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .dba-action span {
    color: var(--current-text-secondary);
    font-size: var(--font-size-xs);
  }

  .dba-contact-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--spacing-sm) var(--spacing-lg);
    border: 1px solid color-mix(in srgb, var(--current-accent-primary) 48%, transparent);
    border-radius: var(--radius-full);
    color: var(--current-text-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .dba-contact-link:hover,
  .dba-contact-link:focus {
    border-color: var(--current-accent-primary);
    background: color-mix(in srgb, var(--current-accent-primary) 12%, transparent);
  }

  a.cta-button {
    display: inline-block;
    text-align: center;
    text-decoration: none;
  }

  @media (max-width: 1023px) {
    .process-panel {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }
  }

  @media (max-width: 767px) {
    .dba-facts,
    .process-steps,
    .boundary-note {
      grid-template-columns: 1fr;
    }

    .dba-facts article {
      min-height: auto;
    }

    .service-card-content,
    .process-panel,
    .boundary-note {
      padding: var(--spacing-lg);
    }

    .subsection-header h3,
    .process-heading h3 {
      font-size: var(--font-size-xl);
    }

    .showcase-grid,
    .showcase-count-2,
    .showcase-count-4 {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      min-height: 0;
    }

    .showcase-count-4 .showcase-item--primary {
      grid-row: auto;
    }

    .showcase-item {
      min-height: 230px;
      aspect-ratio: 16 / 10;
    }

    .dba-action {
      align-items: stretch;
      flex-direction: column;
      text-align: center;
    }
  }
</style>
