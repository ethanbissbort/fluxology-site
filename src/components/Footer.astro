---
// Footer component
// Build-time year: correct without JavaScript; the small script in
// BaseLayout still refreshes it client-side for long-cached pages.
const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <h3 class="footer-logo">Fluxology, Inc.</h3>
        <p class="footer-tagline">Independent software. Trade capability. Long-term resilience.</p>
        <p class="footer-status">Federally incorporated · Ontario · Software development active · Future operating names proposed</p>
      </div>

      <div class="footer-links">
        <div class="footer-column">
          <h4 class="footer-heading">Company</h4>
          <ul class="footer-list" role="list">
            <li><a href="/apps/">Software & Apps</a></li>
            <li><a href="/#about">About Fluxology</a></li>
            <li><a href="/#operating-model">Operating Model</a></li>
            <li><a href="/#roadmap">Roadmap</a></li>
            <li><a href="/#contact">Contact</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h4 class="footer-heading">Future Operating Plans</h4>
          <ul class="footer-list" role="list">
            <li><a href="/fabrication/">Fabrication & Welding</a></li>
            <li><a href="/3d-lab/">3D Lab</a></li>
            <li><a href="/greenhouse/">Greenhouse</a></li>
            <li><a href="/orchard/">Orchard & Food Forest</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h4 class="footer-heading">Support & Legal</h4>
          <ul class="footer-list" role="list">
            <li><a href="/support/">Software Support</a></li>
            <li><a href="/privacy/">Privacy Policy</a></li>
            <li><a href="/terms/">Terms of Use</a></li>
            <li><a href="mailto:info@fluxology.ca">info@fluxology.ca</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; <span id="currentYear">{year}</span> Fluxology, Inc. All rights reserved. Canadian-controlled private corporation.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-status {
    max-width: 480px;
    margin-top: var(--spacing-md);
    color: rgba(255, 255, 255, 0.62);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-loose);
  }
</style>
