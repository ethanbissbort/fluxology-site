---
// Above-the-fold company positioning. This reflects the portfolio's current
// legal status and future launch horizon instead of presenting the DBAs as
// active, staffed divisions.
import { Image } from 'astro:assets';
import logoMedallion from '../assets/images/corporate/logo-medallion.webp';
---

<section class="section hero-section" id="hero" data-theme="corporate">
  <div class="background-layer">
    <div class="parallax-bg"></div>
    <div class="corporate-flux"></div>
  </div>

  <div class="content-layer">
    <div class="container">
      <p class="hero-status">
        <span class="hero-status-dot" aria-hidden="true"></span>
        Federally incorporated · Ontario · 2029-2035 planning horizon
      </p>

      <Image
        class="hero-brand-mark"
        src={logoMedallion}
        alt="Fluxology, Inc. circular flux-wave emblem"
        widths={[160, 320, 440]}
        width={440}
        sizes="(max-width: 767px) 140px, 220px"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <h1 class="hero-title">
        <span class="hero-title-main">Fluxology, Inc.</span>
        <span class="hero-title-sub">Trade-led. Technology-enabled. Homestead-integrated.</span>
      </h1>

      <p class="hero-description">
        A one-owner Canadian-controlled private corporation building a disciplined path from mobile repair and
        fabrication to digital production support and subsistence-first homestead agriculture.
      </p>

      <ul class="hero-facts" role="list">
        <li><strong>1</strong><span>corporation</span></li>
        <li><strong>4</strong><span>proposed operating names</span></li>
        <li><strong>2029</strong><span>earliest commercial launch</span></li>
      </ul>

      <div class="hero-cta-group">
        <a href="#operating-model" class="cta-button cta-primary">See how the pieces fit</a>
        <a href="#roadmap" class="cta-button cta-secondary">View the staged roadmap</a>
      </div>

      <div class="hero-scroll-indicator" aria-hidden="true">
        <span class="scroll-arrow">↓</span>
        <span class="scroll-text">Explore the operating plan</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-status {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: center;
    align-items: center;
    width: fit-content;
    margin: 0 auto var(--spacing-lg);
    padding: var(--spacing-sm) var(--spacing-lg);
    border: 1px solid rgba(168, 218, 220, 0.28);
    border-radius: var(--radius-full);
    background: rgba(9, 30, 45, 0.58);
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .hero-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--corporate-accent-blue);
    box-shadow: 0 0 0 5px rgba(58, 134, 255, 0.13);
  }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-md);
    max-width: 760px;
    margin: calc(var(--spacing-xl) * -1) auto var(--spacing-2xl);
    padding: 0;
    list-style: none;
  }

  .hero-facts li {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacing-md);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    background: rgba(9, 30, 45, 0.38);
    text-align: center;
    backdrop-filter: blur(8px);
  }

  .hero-facts strong {
    color: var(--corporate-accent-silver);
    font-family: var(--font-corporate-heading);
    font-size: var(--font-size-lg);
  }

  .hero-facts span {
    color: rgba(255, 255, 255, 0.68);
    font-size: var(--font-size-xs);
  }

  @media (max-width: 767px) {
    .hero-status {
      max-width: 100%;
      text-align: center;
    }

    .hero-facts {
      grid-template-columns: 1fr;
      gap: var(--spacing-sm);
      margin-top: 0;
    }

    .hero-facts li {
      display: grid;
      grid-template-columns: 76px minmax(0, 1fr);
      text-align: left;
    }

    .hero-facts strong {
      font-size: var(--font-size-md);
    }
  }
</style>
