---
import { Picture } from 'astro:assets';
import valueExcellence from '../assets/images/corporate/value-excellence.webp';
import valueInnovation from '../assets/images/corporate/value-innovation.webp';
import valueSustainability from '../assets/images/corporate/value-sustainability.webp';
import valueIntegrity from '../assets/images/corporate/value-integrity.webp';

const valueImages = [
  {
    src: valueExcellence,
    alt: 'Polished achievement trophy',
    strong: 'Controlled scope',
    text: 'Build products and accept future work only when the scope fits real capability, capacity and support obligations.'
  },
  {
    src: valueInnovation,
    alt: 'Luminous modular technology cube',
    strong: 'Product-led technology',
    text: 'Develop software and technical capability around measured problems rather than speculative scale.'
  },
  {
    src: valueSustainability,
    alt: 'Geometric green and blue leaf',
    strong: 'Subsistence before surplus',
    text: 'In the future homestead phase, secure household food, preservation and propagation needs before agricultural sales.'
  },
  {
    src: valueIntegrity,
    alt: 'Handshake set in a protective shield',
    strong: 'Clear legal identity',
    text: 'Keep Fluxology, Inc. identified as the legal entity behind software publishing and every future operating line.'
  }
];
---

<section class="section about-section" id="about" data-theme="corporate">
  <div class="background-layer">
    <div class="parallax-bg"></div>
    <div class="corporate-flux"></div>
  </div>

  <div class="content-layer">
    <div class="container">
      <header class="section-header observe-fade">
        <p class="about-eyebrow">Company structure</p>
        <h2 class="section-title">One corporation. Software publishing now; staged operating lines later.</h2>
        <p class="section-subtitle">Fluxology, Inc. is the legal entity behind its current software products and its longer-term operating plan.</p>
      </header>

      <div class="legal-status observe-fade">
        <span class="status-dot" aria-hidden="true"></span>
        <p>
          <strong>Fluxology, Inc. is federally incorporated and registered to operate in Ontario.</strong> Software
          development and publishing are direct corporate activities. The four trade and homestead operating names
          presented elsewhere on this site are proposed future names and have not yet been registered.
        </p>
      </div>

      <div class="about-content observe-slide-up">
        <div class="about-text">
          <p class="about-paragraph">
            Fluxology currently develops its own software products, including iOS applications and supporting web
            tools. The company is acting as the developer and publisher of those products; it is not advertising
            contract app-development services for clients.
          </p>

          <p class="about-paragraph">
            The longer-term plan adds four staged operating lines under the same corporation: repair and fabrication,
            digital production support, protected growing, and perennial food systems. Mobile/local welding is not
            planned to begin before 2029. The greenhouse and orchard begin only after a compatible homestead is
            acquired and prioritize household food before sales.
          </p>

          <p class="about-paragraph about-paragraph--accent">
            The corporate structure is deliberately simple: Fluxology, Inc. owns and publishes its software and will
            also be the legal contracting entity behind any future operating names.
          </p>
        </div>

        <div class="about-values">
          <h3 class="values-title">Operating principles</h3>
          <ul class="values-list" role="list">
            {valueImages.map((value) => (
              <li class="value-item">
                <Picture
                  src={value.src}
                  alt={value.alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  widths={[76, 152]}
                  width={152}
                  sizes="(max-width: 767px) 64px, 76px"
                  loading="lazy"
                  decoding="async"
                />
                <span><strong>{value.strong}</strong> {value.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="about-stats observe-slide-up">
        <div class="stat-card">
          <span class="stat-number">1</span>
          <span class="stat-label">Owner + legal entity</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">Now</span>
          <span class="stat-label">Software development</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">iOS</span>
          <span class="stat-label">Apps in active development</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">4</span>
          <span class="stat-label">Proposed future operating names</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  picture {
    display: contents;
  }

  .about-eyebrow {
    margin-bottom: var(--spacing-sm);
    color: var(--corporate-accent-silver);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
  }

  .legal-status {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--spacing-md);
    align-items: start;
    max-width: 1060px;
    margin: calc(var(--spacing-xl) * -1) auto var(--spacing-3xl);
    padding: var(--spacing-lg) var(--spacing-xl);
    border: 1px solid rgba(168, 218, 220, 0.24);
    border-radius: var(--radius-lg);
    background: rgba(9, 30, 45, 0.62);
  }

  .status-dot {
    width: 12px;
    height: 12px;
    margin-top: 0.45rem;
    border-radius: 50%;
    background: var(--corporate-accent-blue);
    box-shadow: 0 0 0 6px rgba(58, 134, 255, 0.13);
  }

  .legal-status p {
    margin: 0;
    color: rgba(255, 255, 255, 0.76);
    line-height: var(--line-height-loose);
  }

  .legal-status strong {
    color: white;
  }

  .about-paragraph--accent {
    padding: var(--spacing-lg);
    border-left: 4px solid var(--corporate-accent-blue);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: rgba(58, 134, 255, 0.08);
    color: white;
    font-weight: var(--font-weight-semibold);
  }

  @media (max-width: 767px) {
    .legal-status {
      margin-top: 0;
      padding: var(--spacing-md);
    }
  }
</style>
