---
// Homepage links stay as in-page anchors. From a DBA detail page, company
// links return to the homepage while division links open the dedicated page.
const isHomepage = Astro.url.pathname === '/';
const homeSection = (id: string) => isHomepage ? `#${id}` : `/#${id}`;
const divisionLink = (id: string) => isHomepage ? `#${id}` : `/${id}/`;
const isCurrentDivision = (id: string) => Astro.url.pathname === `/${id}/`;
const isAppsPage = Astro.url.pathname === '/apps/';
---

<a href="#main-content" class="skip-link">Skip to main content</a>

<nav class="main-nav" id="mainNav" role="navigation" aria-label="Main navigation">
  <div class="nav-container">
    <!-- No aria-label: the visible wordmark text is the accessible name
         (an override tripped WCAG 2.5.3 label-in-name). -->
    <a class="nav-logo" id="navLogo" href={isHomepage ? '#hero' : '/'}>
      <img
        class="nav-logo-mark"
        src="/favicon.svg"
        alt=""
        aria-hidden="true"
        width="36"
        height="36"
      />
      <span class="logo-wordmark">
        <span class="logo-text">Fluxology,</span>
        <span class="logo-inc">Inc.</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      id="navToggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="navLinks"
    >
      <span class="nav-toggle-line"></span>
      <span class="nav-toggle-line"></span>
      <span class="nav-toggle-line"></span>
    </button>

    <ul class="nav-links" id="navLinks" role="list">
      <li><a href={homeSection('about')} class="nav-link" data-section="about">Company</a></li>
      <li><a href="/apps/" class:list={['nav-link', { active: isAppsPage }]} aria-current={isAppsPage ? 'page' : undefined}>Apps</a></li>
      <li><a href={homeSection('operating-model')} class="nav-link" data-section="operating-model">Model</a></li>
      <li><a href={divisionLink('fabrication')} class:list={['nav-link', { active: isCurrentDivision('fabrication') }]} aria-current={isCurrentDivision('fabrication') ? 'page' : undefined} data-section="fabrication">Fabrication</a></li>
      <li><a href={divisionLink('3d-lab')} class:list={['nav-link', { active: isCurrentDivision('3d-lab') }]} aria-current={isCurrentDivision('3d-lab') ? 'page' : undefined} data-section="3d-lab">3D Lab</a></li>
      <li><a href={divisionLink('greenhouse')} class:list={['nav-link', { active: isCurrentDivision('greenhouse') }]} aria-current={isCurrentDivision('greenhouse') ? 'page' : undefined} data-section="greenhouse">Greenhouse</a></li>
      <li><a href={divisionLink('orchard')} class:list={['nav-link', { active: isCurrentDivision('orchard') }]} aria-current={isCurrentDivision('orchard') ? 'page' : undefined} data-section="orchard">Orchard</a></li>
      <li><a href={homeSection('roadmap')} class="nav-link" data-section="roadmap">Roadmap</a></li>
      <li><a href={homeSection('contact')} class="nav-link" data-section="contact">Contact</a></li>
    </ul>
  </div>
</nav>

<style>
  /* Navigation specific styles that override/extend base.css */

  /* Logo lockup: emblem + wordmark. The emblem keeps its brand colours while
     the wordmark text still shifts colour per active section (see the
     .main-nav[data-current-theme] rules in transitions.css). */
  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .nav-logo-mark {
    width: 36px;
    height: 36px;
    display: block;
    flex-shrink: 0;
  }

  .logo-wordmark {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
  }

  @media (max-width: 400px) {
    /* Keep just the emblem on very narrow screens to preserve nav space. */
    .logo-wordmark {
      display: none;
    }
  }

  .skip-link {
    /* fixed, not absolute: with no positioned ancestor `top: 0` resolved
       against the document, so a link focused at any scroll offset rendered
       off-screen unless the browser scrolled the page back to the top. */
    position: fixed;
    top: -100px;
    left: 0;
    /* #3A86FF is only 3.48:1 under white at this 18px regular size; the deep
       tone is 5.49:1 and clears AA. */
    background: var(--corporate-accent-blue-deep);
    color: white;
    padding: var(--spacing-md);
    text-decoration: none;
    z-index: 1000;
    transition: top var(--transition-fast) var(--ease-out-cubic);
  }

  .skip-link:focus {
    top: 0;
  }
</style>
