---
import { Font } from 'astro:assets';
import CursorEffects from '../components/CursorEffects.svelte';
import { dbaPlans } from '../data/dbaPlans';

import '../styles/reset.css';
import '../styles/variables.css';
import '../styles/base.css';
import '../styles/themes.css';
import '../styles/transitions.css';
import '../styles/utilities.css';
import '../styles/responsive.css';

type Theme = 'corporate' | 'industrial' | 'tech' | 'natural';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  theme?: Theme;
}

const {
  title,
  description = "Fluxology, Inc. is a Canadian-controlled private corporation developing and publishing its own software products while building staged future operating plans for fabrication, digital production support and homestead food systems.",
  noindex = false,
  theme,
} = Astro.props;

const currentDba = dbaPlans.find((plan) => Astro.url.pathname === `/${plan.slug}/`);
const resolvedTheme: Theme = theme ?? currentDba?.overview.theme ?? 'corporate';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL('/images/corporate/logo-medallion.webp', Astro.site);
const socialImageWidth = 640;
const socialImageHeight = 640;
const socialImageAlt = 'Fluxology, Inc. logo medallion';

type PreloadFilter = import('astro:assets').FontPreloadFilter;
const themeHeadingPreload: Record<Theme, { cssVariable: string; preload: PreloadFilter }> = {
  corporate: { cssVariable: '--font-outfit', preload: true },
  industrial: { cssVariable: '--font-rajdhani', preload: [{ weight: 700 }] },
  tech: { cssVariable: '--font-space-grotesk', preload: true },
  natural: { cssVariable: '--font-sora', preload: true },
};

const fontVariables = [
  '--font-outfit',
  '--font-open-sans',
  '--font-inter',
  '--font-rajdhani',
  '--font-space-grotesk',
  '--font-dm-sans',
  '--font-sora',
  '--font-nunito',
  '--font-quicksand',
];

const headingFont = themeHeadingPreload[resolvedTheme];
const fontPreload = (cssVariable: string): PreloadFilter =>
  cssVariable === '--font-outfit' || cssVariable === '--font-open-sans'
    ? true
    : cssVariable === headingFont.cssVariable
      ? headingFont.preload
      : false;

const organizationSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Fluxology, Inc.',
  url: Astro.site?.toString(),
  logo: socialImageURL.toString(),
  email: 'info@fluxology.ca',
  description:
    'Canadian-controlled private corporation developing and publishing independent software products, including iOS applications and supporting web tools, with staged future operating plans in fabrication, digital production support and homestead food systems.',
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="keywords" content="Fluxology, software publisher, iOS apps, Office Scout, Fluxology Deals, mobile welding, custom fabrication, 3D scanning, Ontario">
  <meta name="author" content="Fluxology, Inc.">

  <title>{title}</title>

  {noindex && <meta name="robots" content="noindex">}
  {!noindex && <link rel="canonical" href={canonicalURL}>}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Fluxology, Inc.">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  {!noindex && <meta property="og:url" content={canonicalURL}>}
  <meta property="og:image" content={socialImageURL}>
  <meta property="og:image:width" content={String(socialImageWidth)}>
  <meta property="og:image:height" content={String(socialImageHeight)}>
  <meta property="og:image:alt" content={socialImageAlt}>
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={socialImageURL}>
  <meta name="twitter:image:alt" content={socialImageAlt}>

  <script type="application/ld+json" set:html={organizationSchema} is:inline></script>

  <script is:inline>
    (function () {
      var root = document.documentElement;
      root.classList.add('js-reveal');
      var release = function () {
        if (!root.classList.contains('reveal-ready')) root.classList.remove('js-reveal');
      };
      var arm = function () { setTimeout(release, 2500); };
      if (document.readyState === 'complete') arm();
      else window.addEventListener('load', arm);
    })();
  </script>

  {fontVariables.map((cssVariable) => (
    <Font cssVariable={cssVariable} preload={fontPreload(cssVariable)} />
  ))}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#1B3A4B">
</head>
<body>
  <slot />

  <CursorEffects client:idle />

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/service-worker.js').catch(() => {
          // Registration failure is non-fatal.
        });
      });
    }

    const yearElement = document.getElementById('currentYear');
    if (yearElement) {
      yearElement.textContent = new Date().getFullYear().toString();
    }
  </script>
</body>
</html>
