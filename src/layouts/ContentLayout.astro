---
import BaseLayout from './BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import NavigationMenu from '../components/NavigationMenu.svelte';
import BackToTop from '../components/BackToTop.svelte';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  heading: string;
  intro?: string;
}

const {
  title,
  description,
  eyebrow = 'Fluxology, Inc.',
  heading,
  intro,
} = Astro.props;
---

<BaseLayout title={title} description={description} theme="corporate">
  <BackToTop client:load />
  <Navigation />
  <NavigationMenu client:load />

  <main id="main-content" tabindex="-1" class="content-page">
    <header class="content-hero">
      <div class="container content-container">
        <p class="content-eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
        {intro && <p class="content-intro">{intro}</p>}
      </div>
    </header>

    <div class="container content-container content-body">
      <slot />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  .content-page {
    min-height: 70vh;
    background:
      radial-gradient(circle at 18% 0%, rgba(58, 134, 255, 0.12), transparent 34rem),
      linear-gradient(180deg, #071d2b 0%, #092433 100%);
    color: rgba(255, 255, 255, 0.84);
  }

  .content-container {
    max-width: 980px;
  }

  .content-hero {
    padding: calc(var(--spacing-4xl) + 4rem) 0 var(--spacing-3xl);
    border-bottom: 1px solid rgba(168, 218, 220, 0.16);
  }

  .content-eyebrow {
    margin-bottom: var(--spacing-sm);
    color: var(--corporate-accent-silver);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
  }

  .content-hero h1 {
    max-width: 850px;
    margin-bottom: var(--spacing-lg);
    color: #fff;
    font-family: var(--font-corporate-heading);
  }

  .content-intro {
    max-width: 820px;
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: var(--font-size-lg);
    line-height: var(--line-height-loose);
  }

  .content-body {
    padding-top: var(--spacing-3xl);
    padding-bottom: var(--spacing-4xl);
  }

  .content-body section + section {
    margin-top: var(--spacing-3xl);
  }

  .content-body h2,
  .content-body h3 {
    color: #fff;
    font-family: var(--font-corporate-heading);
  }

  .content-body h2 {
    margin-bottom: var(--spacing-md);
    font-size: clamp(1.65rem, 3vw, 2.2rem);
  }

  .content-body h3 {
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-sm);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
  }

  .content-body p,
  .content-body li {
    line-height: var(--line-height-loose);
  }

  .content-body p + p {
    margin-top: var(--spacing-md);
  }

  .content-body ul,
  .content-body ol {
    margin: var(--spacing-md) 0 0;
    padding-left: 1.4rem;
  }

  .content-body li + li {
    margin-top: var(--spacing-sm);
  }

  .content-body a {
    color: #8ec8ff;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .content-body a:hover,
  .content-body a:focus-visible {
    color: #c4e4ff;
  }

  .content-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-lg);
    margin-top: var(--spacing-xl);
  }

  .content-card {
    padding: var(--spacing-xl);
    border: 1px solid rgba(168, 218, 220, 0.18);
    border-radius: var(--radius-lg);
    background: rgba(9, 30, 45, 0.7);
  }

  .content-card h3 {
    margin-top: 0;
  }

  .content-callout {
    margin-top: var(--spacing-xl);
    padding: var(--spacing-xl);
    border: 1px solid rgba(58, 134, 255, 0.32);
    border-left: 4px solid var(--corporate-accent-blue);
    border-radius: var(--radius-md);
    background: rgba(58, 134, 255, 0.08);
  }

  .content-meta {
    color: rgba(255, 255, 255, 0.58);
    font-size: var(--font-size-sm);
  }

  @media (max-width: 767px) {
    .content-hero {
      padding-top: calc(var(--spacing-3xl) + 4rem);
    }

    .content-card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
