# Fluxology application-stack environment
# Copy to .env on the VPS and chmod 600 .env.
# The edge proxy is a separate VPS service and is not configured here.

TIMEZONE=America/Toronto

# -----------------------------------------------------------------------------
# Contact API abuse limits
# -----------------------------------------------------------------------------
#RATE_LIMIT_MAX=5
#RATE_LIMIT_WINDOW_MS=900000
#MAX_BODY_BYTES=32768

# -----------------------------------------------------------------------------
# Contact API mail delivery (optional)
# -----------------------------------------------------------------------------
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASS=
#MAIL_TO=info@fluxology.ca
#MAIL_FROM=

# -----------------------------------------------------------------------------
# Dashboard API
# -----------------------------------------------------------------------------
# Writes stay disabled for a category while its token is unset. Generate three
# independent secrets and put the real values in the VPS .env:
#
#   openssl rand -hex 32
#
# Never put real tokens in this example file or in public frontend code.
#OFFICE_INGEST_TOKEN=
#DEALS_INGEST_TOKEN=
#JOBS_INGEST_TOKEN=

# Maximum JSON request size accepted by the dashboard API (default 1 MiB).
#DASHBOARD_MAX_BODY_BYTES=1048576

# Maximum records accepted in one upsert/replace request (default 500).
#DASHBOARD_MAX_LISTINGS_PER_WRITE=500

# -----------------------------------------------------------------------------
# MCP connector (fluxology-mcp)
# -----------------------------------------------------------------------------
# Authenticated write bridge between approved model clients and the dashboard
# API. See docs/MCP-CONNECTOR.md. It reuses the three ingest tokens above; it
# does not need its own downstream credentials.
#
# The connector is an OAuth 2.1 resource server. It does NOT issue tokens: point
# MCP_OAUTH_ISSUER at a standards-compliant authorization server. Startup fails
# without an issuer unless development auth is explicitly enabled.

# Canonical MCP resource identifier. Must match the edge-proxy hostname exactly
# and must be https in production — it is also the required token audience.
#MCP_PUBLIC_URL=https://mcp.fluxology.ca/mcp

# Authorization server that issues MCP access tokens.
#MCP_OAUTH_ISSUER=https://auth.fluxology.ca

# Defaults to MCP_PUBLIC_URL. Only set this if the issuer mints a different
# audience value for the resource.
#MCP_OAUTH_AUDIENCE=https://mcp.fluxology.ca/mcp

# Optional: skip authorization-server metadata discovery.
#MCP_OAUTH_JWKS_URI=https://auth.fluxology.ca/.well-known/jwks.json

# Abuse limits (per authenticated subject).
#MCP_MAX_BODY_BYTES=524288
#MCP_MAX_LISTINGS_PER_WRITE=50
#MCP_READS_PER_MINUTE=120
#MCP_WRITES_PER_MINUTE=30
#MCP_LOG_LEVEL=info

# Development bearer auth. NEVER set these on a publicly reachable deployment:
# startup fails outright when NODE_ENV=production and dev auth is enabled.
#MCP_DEV_AUTH_ENABLED=false
#MCP_DEV_AUTH_TOKEN=
#MCP_DEV_AUTH_SCOPES=dashboards:read office:write deals:write jobs:write
