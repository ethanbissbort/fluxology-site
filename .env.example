# Fluxology application-stack environment
# Copy to .env on the VPS and chmod 600 .env.
# The edge proxy is a separate VPS service and is not configured here.

TIMEZONE=America/Toronto

# -----------------------------------------------------------------------------
# Contact API abuse limits
# -----------------------------------------------------------------------------
#RATE_LIMIT_MAX=5
#RATE_LIMIT_WINDOW_MS=900000
#MAX_BODY_BYTES=32768

# -----------------------------------------------------------------------------
# Contact API mail delivery (optional)
# -----------------------------------------------------------------------------
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASS=
#MAIL_TO=info@fluxology.ca
#MAIL_FROM=

# -----------------------------------------------------------------------------
# Dashboard API
# -----------------------------------------------------------------------------
# Generate three independent secrets, for example:
#   openssl rand -hex 32
#
# Keep the real tokens only in the VPS .env and in whatever trusted connector
# or automation is allowed to write that category. They must never appear in
# public JavaScript or committed JSON.
OFFICE_INGEST_TOKEN=replace-with-random-secret
DEALS_INGEST_TOKEN=replace-with-random-secret
JOBS_INGEST_TOKEN=replace-with-random-secret

# Maximum JSON request size accepted by the dashboard API (default 1 MiB).
#DASHBOARD_MAX_BODY_BYTES=1048576

# Maximum records accepted in one upsert/replace request (default 500).
#DASHBOARD_MAX_LISTINGS_PER_WRITE=500
