# Fluxology — environment configuration
# =============================================================================
# Copy to `.env` (same directory as docker-compose.yml) and edit. Every
# variable below is consumed by docker-compose.yml; nothing here is required —
# the stack starts correctly with no .env file at all, using the defaults shown.
#
# NEVER commit a real .env. NEVER put real credentials in THIS file.
# =============================================================================


# -----------------------------------------------------------------------------
# Host ports  (published by the caddy service only)
# -----------------------------------------------------------------------------
# Caddy is the single public entrypoint. Apache and contact-api are no longer
# published to the host at all — they are reached over the internal compose
# network — so the old "HTTP_PORT=6080" (which published Apache directly) no
# longer applies. If you are upgrading, delete that line from your .env.
#
# Leave both at the defaults unless another service already owns 80/443.
# WARNING: Let's Encrypt's HTTP-01 challenge and the http->https redirect both
# require the public port 80 to reach this container, and the certificate
# handshake requires public port 443. Changing these only works if something
# upstream (another proxy, a NAT/port-forward rule) still maps 80 -> HTTP_PORT
# and 443 -> HTTPS_PORT.
HTTP_PORT=80
HTTPS_PORT=443

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# Timezone applied to all three containers (affects log timestamps and the
# `receivedAt` rendering in tooling around the inquiry log).
TIMEZONE=America/Toronto


# -----------------------------------------------------------------------------
# Contact API — abuse limits
# -----------------------------------------------------------------------------
# Defaults are sensible for a low-traffic marketing site; uncomment to change.
# RATE_LIMIT_MAX: submissions allowed per IP per window.
# RATE_LIMIT_WINDOW_MS: window length in milliseconds (900000 = 15 minutes).
# MAX_BODY_BYTES: request body cap enforced by the service (32768 = 32 KB).
#   Caddy independently rejects anything over 64 KB before it reaches Node, so
#   raising this past 64 KB has no effect without also raising `max_size` in
#   caddy/Caddyfile.
#RATE_LIMIT_MAX=5
#RATE_LIMIT_WINDOW_MS=900000
#MAX_BODY_BYTES=32768


# -----------------------------------------------------------------------------
# Contact API — email delivery (OPTIONAL — currently unused)
# -----------------------------------------------------------------------------
# There is no mail hosting yet, and none is needed. With SMTP_HOST unset (the
# state of this file as shipped) the contact API runs in LOG-ONLY MODE:
#
#   * every valid inquiry is appended to /data/inquiries.jsonl on the
#     `inquiry_data` volume BEFORE the visitor gets a success response, so
#     nothing is lost;
#   * no email is attempted and no error is raised — the service logs one
#     informational line at startup saying email is disabled.
#
# Read the inquiries any time with:
#   docker compose exec contact-api cat /data/inquiries.jsonl
#
# When mail hosting exists, uncomment SMTP_HOST (plus whatever else the
# provider requires) and run `docker compose up -d contact-api`. Setting
# SMTP_HOST is the switch that turns email on; leaving it commented out or
# empty keeps log-only mode.

# Hostname of the SMTP relay. THE ON/OFF SWITCH — unset means log-only.
#SMTP_HOST=smtp.example.com

# 587 = STARTTLS (the usual choice), 465 = implicit TLS, 25 = unauthenticated
# relay on a trusted network. Default 587.
#SMTP_PORT=587

# `true` only for implicit TLS on port 465. For 587/STARTTLS leave it false.
# Default false.
#SMTP_SECURE=false

# Credentials for authenticated relays. Omit BOTH for an unauthenticated relay.
# Put the real values in `.env`, never in this example file, and keep `.env`
# out of git (it is already in .gitignore). Consider `chmod 600 .env` on the
# VPS — the password is readable by anything that can read the file.
#SMTP_USER=
#SMTP_PASS=

# Where inquiry notifications are delivered. Default info@fluxology.ca.
#MAIL_TO=info@fluxology.ca

# Envelope sender. Many relays reject mail whose From is not a domain you own,
# so set this to a real mailbox on your sending domain once you have one.
# Defaults to MAIL_TO when unset. The visitor's address is never used as the
# sender — it goes in Reply-To only.
#MAIL_FROM=
